# NOTARIS PRO — contoh variabel lingkungan
# Salin menjadi .env hanya bila Anda memakai Prisma CLI (generate/migrate diff).
# Aplikasi yang sudah berjalan TIDAK membaca DATABASE_URL: lokasi database
# ditentukan oleh folder data aplikasi (lihat docs/ARSITEKTUR.md).

# Dipakai Prisma CLI dari root proyek. Bukan database produksi pengguna.
DATABASE_URL="file:./prisma/dev.db"

# Opsional: menimpa folder data aplikasi. Berguna untuk pengujian/portable.
# Jangan arahkan ke folder instalasi aplikasi.
# NOTARIS_DATA_DIR="D:/NotarisData"

# JANGAN dipakai di produksi. Menonaktifkan enkripsi vault sehingga database
# tersimpan sebagai plaintext. Hanya untuk pengembangan dan pengujian otomatis.
# NOTARIS_VAULT=off
